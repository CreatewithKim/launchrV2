# --- REQUIRED IN PRODUCTION (the API returns 503 until all three are set) ---
# MySQL connection string. Apply migrations first: npx drizzle-kit migrate
# Local development may leave this empty to use a temporary in-memory store.
DATABASE_URL=

# Port (defaults to 3000 in AI Studio environment)
PORT=3000

# BetterAuth. Secret must be 32+ random characters (e.g. `openssl rand -base64 48`).
# URL is your public origin, e.g. https://launchr-chi.vercel.app
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# Social Authentication Providers (Optional credentials for 1-click social logins)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Email Provider Configuration (Optional: for production delivery of Magic Links & OTP codes)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Legacy Auth configuration (backward compatibility)
JWT_SECRET=
OWNER_OPEN_ID=
VITE_APP_ID=
OAUTH_SERVER_URL=
VITE_OAUTH_PORTAL_URL=

# Storage configuration (optional: in-memory file proxy used if unset)
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Gemini API Key (server-side only)
GEMINI_API_KEY=
